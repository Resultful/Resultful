<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Roslyn 5.x build of Resultful.Analyzers: the same sources, compiled against the lowest 5.x (5.0.0, SDK
    10.0.1xx), so no 5.x compiler reports CS9057. Packed by Resultful.Analyzers.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Resultful.Analyzers</AssemblyName>
    <RootNamespace>Resultful.Analyzers</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);RS1038</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Resultful.Analyzers/**/*.cs" Exclude="../Resultful.Analyzers/bin/**;../Resultful.Analyzers/obj/**" />
    <AdditionalFiles Include="../Resultful.Analyzers/AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="../Resultful.Analyzers/AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="5.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Resultful.Analyzers.Tests" />
  </ItemGroup>

</Project>
