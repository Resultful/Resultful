<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <AssemblyName>Resultful.Text.Json</AssemblyName>
    <RootNamespace>Resultful.Text.Json</RootNamespace>
    <Description>System.Text.Json converters for Resultful: a fixed wire format for results, validations and errors. AOT-safe and source-generation friendly.</Description>
    <PackageId>Resultful.Text.Json</PackageId>
    <PackageTags>result;railway-oriented-programming;error-handling;json;system.text.json</PackageTags>
    <EnablePackageValidation>true</EnablePackageValidation>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <!-- This package's own readme replaces the core's, which src/Directory.Build.props packs by default. -->
    <None Remove="$(MSBuildThisFileDirectory)../../README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Resultful\Resultful.csproj" />
    <!-- One pair: the API is the same on both targets. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
