<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Not packed until 13b, which builds one copy per Roslyn version into the package. -->
    <IsPackable>false</IsPackable>
    <!-- CA1305: generated text is culture-free string interpolation of names. CA1822: analyzer helpers kept as instance-free statics by design. -->
    <NoWarn>$(NoWarn);CA1305;CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- One build for now, against Roslyn 4.14.0 (SDK 9.0.3xx): it loads in every later compiler. The central version
         is the tests' 5.12.0, so this pins its own. The per-Roslyn split is 13b. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
