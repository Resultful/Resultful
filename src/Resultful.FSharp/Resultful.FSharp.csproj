<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0;net11.0</TargetFrameworks>
    <AssemblyName>Resultful.FSharp</AssemblyName>
    <RootNamespace>Resultful.FSharp</RootNamespace>
    <Description>Converts Resultful's results, validations and options to and from FSharp.Core's Result, option and voption.</Description>
    <PackageId>Resultful.FSharp</PackageId>
    <PackageTags>result;railway-oriented-programming;error-handling;functional;fsharp</PackageTags>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <!-- This package's own readme replaces the core's, which src/Directory.Build.props packs by default. -->
    <None Remove="$(MSBuildThisFileDirectory)../../README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Resultful\Resultful.csproj" />
    <!-- FSharp.Core 4.5.0 is the lowest with voption (FSharpValueOption) and has an empty netstandard2.0 group, so it
         brings no NETStandard.Library 1.x packages (decision 5). Consumers on a newer FSharp.Core resolve upwards. -->
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
