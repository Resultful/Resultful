<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <AssemblyName>Resultful.HotChocolate</AssemblyName>
    <RootNamespace>Resultful.HotChocolate</RootNamespace>
    <Description>HotChocolate for Resultful: resolvers return results or shapes, and their error cases become GraphQL error types under the query and mutation conventions.</Description>
    <PackageId>Resultful.HotChocolate</PackageId>
    <PackageTags>result;railway-oriented-programming;error-handling;graphql;hotchocolate</PackageTags>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <!-- This package's own readme replaces the core's, which src/Directory.Build.props packs by default. -->
    <None Remove="$(MSBuildThisFileDirectory)../../README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Resultful\Resultful.csproj" />
    <PackageReference Include="HotChocolate.Types.Queries" />
    <PackageReference Include="HotChocolate.Types.Mutations" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- One pair: the API is the same on both targets. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
