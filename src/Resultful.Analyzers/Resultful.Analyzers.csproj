<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Resultful.Analyzers (roadmap M4, decision 15): rules that read attributes by full name, never a Resultful type.
    16a: RF0001 (a [MustObserve] value never observed) and RF0002 (a result created with default), with RF0001's fix.
    The IDs, severities, titles and .editorconfig keys are tests/Resultful.TargetApi/Resultful.Analyzers/*.tsv.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Not packed until 17, which builds one copy per Roslyn version into the package. -->
    <IsPackable>false</IsPackable>
    <!-- RS1038: the code fix shares the assembly because SpecHarness (04c) loads CodeFixProviders from
         Resultful.Analyzers.dll. The analyzers never touch a Workspaces type, so they load in csc without it.
         17 may split the fix into its own assembly when it packs the analyzers. -->
    <NoWarn>$(NoWarn);RS1038</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <!-- The code fix lives in the same assembly: SpecHarness loads CodeFixProviders from Resultful.Analyzers.dll. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Resultful.Analyzers.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
</Project>
