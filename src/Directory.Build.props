<Project>
  <!-- Package settings, for every project under src/. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <Authors>Ryan Kelly</Authors>
    <PackageProjectUrl>https://github.com/Resultful/Resultful</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Resultful/Resultful.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Lockstep: every Resultful.* package shares this version and one release tag. Keep the betaNN form: NuGet compares
         pre-release labels lexically, so beta.6 would sort below beta05. -->
    <VersionPrefix>0.2.0</VersionPrefix>
    <VersionSuffix>beta06</VersionSuffix>
    <PackageReleaseNotes>See https://github.com/Resultful/Resultful/blob/main/RELEASE_NOTES.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Every public member is documented: the XML file ships in the package, and a missing comment fails the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
