<Project>
  <!-- Package settings, for every project under src/. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <Authors>Ryan Kelly</Authors>
    <PackageProjectUrl>https://github.com/Resultful/Resultful</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Resultful/Resultful.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      No release version is committed (decision 22). Local and CI builds are 0.0.0-dev; the release workflow
      (.github/workflows/release.yml) writes the gitignored release-versions.props at the repository root, which
      sets each package's version (and package validation baseline) for that run only.
    -->
    <VersionPrefix>0.0.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)../release-versions.props" Condition="Exists('$(MSBuildThisFileDirectory)../release-versions.props')" />

  <!--
    Every analyzer rule is on for the packages (tests and samples stay at latest-recommended, from the root).
    Rules a package can't fix are turned off in that package's project file, one entry per rule with its reason
    (Resultful's are tied to the 0.2.0-beta06 IL and API freeze).
  -->
  <PropertyGroup>
    <AnalysisLevel>latest-all</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
