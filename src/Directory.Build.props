<Project>
  <!-- Package settings, for every project under src/. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <Authors>Ryan Kelly</Authors>
    <PackageProjectUrl>https://github.com/Resultful/Resultful</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Resultful/Resultful.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      One version for every package (lockstep, decision 11). Stable 0.2.0: beta06's API and code
      (PublicAPI.Shipped.txt, package validation). The published package has no suffix; only CI's packed
      consumption run repacks the same build with a run-unique -p:VersionSuffix.
      A pre-release keeps the betaNN form: NuGet compares pre-release labels lexically, so beta.6 would sort below beta05.
    -->
    <VersionPrefix>0.2.0</VersionPrefix>
  </PropertyGroup>

  <!--
    Every analyzer rule is on for the packages (tests and samples stay at latest-recommended, from the root).
    Rules a package can't fix are turned off in that package's project file, one entry per rule with its reason
    (Resultful's are tied to the 0.2.0-beta06 IL and API freeze).
  -->
  <PropertyGroup>
    <AnalysisLevel>latest-all</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
