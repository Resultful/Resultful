<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0;net11.0</TargetFrameworks>
    <AssemblyName>Resultful</AssemblyName>
    <Description>Functional Error Handling library that is intended to be idiomatic for C#. Based on the Railway Oriented Programming idea</Description>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Resultful</PackageId>
    <PackageTags>result;railway-oriented-programming;error-handling;functional</PackageTags>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every public API change shows up as a diff of PublicAPI.Unshipped.txt in review. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <!--
      The few lines that differ by target: a derived record's <Clone>$ returns the record itself only where covariant
      returns exist (not netstandard2.0). The analyzer reads every PublicAPI.*.txt it is given, so these add to the pair above.
    -->
    <AdditionalFiles Include="PublicApi/NetStandard/PublicAPI.Unshipped.txt" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <AdditionalFiles Include="PublicApi/Net/PublicAPI.Unshipped.txt" Condition="'$(TargetFramework)' != 'netstandard2.0'" />
  </ItemGroup>

</Project>
