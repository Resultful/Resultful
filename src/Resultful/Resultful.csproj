<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0;net11.0</TargetFrameworks>
    <AssemblyName>Resultful</AssemblyName>
    <Description>Functional Error Handling library that is intended to be idiomatic for C#. Based on the Railway Oriented Programming idea</Description>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The package version is set per release, never committed (decision 22): see src/Directory.Build.props. -->
    <!--
      Every published 0.2.0 pre-release (beta03 to beta05) has assembly and file version 1.0.0.0. A lower assembly
      version breaks apps on .NET Core that use a library compiled against one of them (FileNotFoundException:
      Resultful, Version=1.0.0.0), so 0.2.x keeps 1.0.0.0. The CompatUpgrade target in eng/build.cs checks it.
    -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageId>Resultful</PackageId>
    <PackageTags>result;railway-oriented-programming;error-handling;functional;oneof</PackageTags>
    <PackageReleaseNotes>See https://github.com/Resultful/Resultful/blob/main/RELEASE_NOTES.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    AnalysisLevel is latest-all for src/ (src/Directory.Build.props). 0.2.0 must be the same library as 0.2.0-beta06:
    the same IL and the same public API (PublicAPI.Shipped.txt). So a rule whose fix would change a method
    body or add, remove or change a public member is turned off here instead, one entry per rule, each with its
    reason. CA1000 and CA1716 are off for every project, in the root Directory.Build.props.
  -->
  <PropertyGroup>
    <!-- CA1002 (don't expose List<T>): the List<string> conversions on Result<T> and VoidResult are public API. -->
    <NoWarn>$(NoWarn);CA1002</NoWarn>
    <!-- CA1052 (static holder types should be static or sealed): sealing Unit changes a public type. -->
    <NoWarn>$(NoWarn);CA1052</NoWarn>
    <!-- CA1062 (validate arguments): a null check changes the method body; the hits are sequences, tasks and step arrays used unchecked or checked by a helper the rule can't see. -->
    <NoWarn>$(NoWarn);CA1062</NoWarn>
    <!-- CA1815 (override equality on value types): Equals and == on the result types would be new public API. -->
    <NoWarn>$(NoWarn);CA1815</NoWarn>
    <!-- CA2007 (ConfigureAwait): adding it to the six awaits without it changes method bodies. -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>
    <!-- CA2225 (named alternates for operators): ToResult, FromT and the like would be new public API. -->
    <NoWarn>$(NoWarn);CA2225</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      OneOf's floor matters to consumers using lowest-matching resolution (Paket strategy: min).
      OneOf 3.0.178 only had a .NETStandard1.3 group, which drags NETStandard.Library 1.6.1 and the
      vulnerable System.Net.Http / System.Text.RegularExpressions 4.3.0 into net8+ apps.
      3.0.271 adds an empty netstandard2.0 group. eng/verify-package.cs enforces this floor.
    -->
    <PackageReference Include="OneOf" />
    <!-- Every public API change shows up as a diff of a PublicAPI.Unshipped.txt in review. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- Single shared PublicAPI pair across all target frameworks (identical public surface in 0.2). -->
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
