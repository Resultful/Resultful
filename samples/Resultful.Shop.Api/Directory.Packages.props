<Project>
  <!-- Adds only what the root file lacks. Moved up into the root Directory.Packages.props at wiring. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)../'))" />
  <!-- Dependencies follow the target (GOAL.md, Known traps). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
  </ItemGroup>
</Project>
