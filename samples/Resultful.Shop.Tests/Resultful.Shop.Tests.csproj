<Project Sdk="Microsoft.NET.Sdk">
  <!-- UC08: tests that check an error's type and data, not its text. NUnit, as the docs show. -->
  <Import Project="../Resultful.Shop.Build/Shop.props" />
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Resultful.Shop.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <!-- CA1515: NUnit needs public test classes. Listed in the PR body. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Resultful.Shop.Api/Resultful.Shop.Api.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>
  <Import Project="../Resultful.Shop.Build/Shop.targets" />
</Project>
