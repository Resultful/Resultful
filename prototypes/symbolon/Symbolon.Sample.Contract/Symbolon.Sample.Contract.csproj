<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The contract: everything the spec defines that a caller needs too. Types, response unions, the handler interfaces,
    validation, and PetStoreClient, which implements the handler interfaces over HTTP. The service and any consumer or
    test suite reference this; only the service generates endpoints.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PetStore</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="petstore.yaml" Symbolon="true" SymbolonNamespace="PetStore.Api" SymbolonApiName="PetStore" SymbolonParts="Contract" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Symbolon" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="SymbolonNamespace" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="SymbolonApiName" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="SymbolonParts" />
  </ItemGroup>

  <ItemGroup>
    <!-- ProblemDetails and HttpValidationProblemDetails are ASP.NET Core types; see the README's limits. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../../Resultful/Resultful.csproj" />
    <!-- Referencing the fakes runtime turns on the generated fake and scenario builder. -->
    <ProjectReference Include="../Symbolon.Fakes/Symbolon.Fakes.csproj" />
    <ProjectReference Include="../Symbolon.Generator/Symbolon.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
