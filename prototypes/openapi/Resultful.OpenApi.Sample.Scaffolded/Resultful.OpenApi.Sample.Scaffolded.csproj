<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The Pet Store service as Resultful.OpenApi.Scaffold writes it, untouched: controllers, a reference implementation that
    answers with the spec's examples, conventions and Program.cs. Only this project file was written by hand. The contract
    comes from the Contract project; nothing on the server side is generated at build time.
    The command that wrote it is in PETSTORE.md, and ScaffoldTests checks that it still writes exactly these files.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PetStore.Scaffolded</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Verify: the build checks these hand-written controllers against the spec. Every operation must have an action with
      its operationId, route and documented responses, and every other action must be left out of the OpenAPI description.
      Nothing is generated here.
    -->
    <AdditionalFiles Include="../Resultful.OpenApi.Sample.Contract/petstore.yaml" ResultfulOpenApi="true" ResultfulNamespace="PetStore.Api" ResultfulApiName="PetStore" ResultfulParts="Verify" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="ResultfulOpenApi" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="ResultfulNamespace" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="ResultfulApiName" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="ResultfulParts" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Resultful.OpenApi.Generator/Resultful.OpenApi.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Resultful.OpenApi.Sample.Contract/Resultful.OpenApi.Sample.Contract.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
</Project>
