<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Resultful.OpenApi.Sample/Resultful.OpenApi.Sample.csproj" />
    <ProjectReference Include="../Resultful.OpenApi.Sample.Fake/Resultful.OpenApi.Sample.Fake.csproj" />
    <ProjectReference Include="../Resultful.OpenApi.Sample.Scaffolded/Resultful.OpenApi.Sample.Scaffolded.csproj" />
    <ProjectReference Include="../Resultful.OpenApi.Testing/Resultful.OpenApi.Testing.csproj" />
    <ProjectReference Include="../Resultful.OpenApi.Generator/Resultful.OpenApi.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Regression: the suite generated from the spec (PetStoreRegression), rebuilt whenever the spec changes. -->
    <AdditionalFiles Include="../Resultful.OpenApi.Sample.Contract/petstore.yaml" ResultfulOpenApi="true" ResultfulNamespace="PetStore.Api" ResultfulApiName="PetStore" ResultfulParts="Regression" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="ResultfulOpenApi" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="ResultfulNamespace" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="ResultfulApiName" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="ResultfulParts" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Reads the input spec for the drift check; matches the Microsoft.OpenApi that ASP.NET Core 10 uses. -->
    <PackageReference Include="Microsoft.OpenApi.YamlReader" VersionOverride="2.12.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../Resultful.OpenApi.Sample.Contract/petstore.yaml" Link="petstore.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Scenarios/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
