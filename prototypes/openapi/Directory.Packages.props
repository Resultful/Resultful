<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)../'))" />
  <ItemGroup>
    <!-- Generator (runs inside the compiler) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.0" />
    <PackageVersion Include="Microsoft.OpenApi.YamlReader" Version="3.11.0" />
    <PackageVersion Include="SharpYaml" Version="2.1.5" />

    <!-- Sample app and its tests -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
  </ItemGroup>
</Project>
