<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Generator (runs inside the compiler) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.0" />
    <PackageVersion Include="Microsoft.OpenApi.YamlReader" Version="3.11.0" />
    <PackageVersion Include="SharpYaml" Version="2.1.5" />

    <!-- Sample app and its tests -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />

    <!-- The samples' handlers, and the opt-in adapter (MatchmarkOutcomes="Resultful"), return Resultful's types. -->
    <PackageVersion Include="Resultful" Version="0.2.0-beta05" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="NUnit" Version="4.3.2" />
    <PackageVersion Include="NUnit3TestAdapter" Version="5.0.0" />

    <!-- The NATS transport for generated AsyncAPI producers and consumers (Matchmark.Messaging.Nats). Apache-2.0. -->
    <PackageVersion Include="NATS.Client.Core" Version="3.3.2" />

    <!-- Assertions: the Apache-2.0 fork of FluentAssertions, which needs a commercial licence from v8. -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <!-- The independent oracle (OracleTests): a JSON Schema 2020-12 validator written apart from Matchmark. Apache-2.0. -->
    <PackageVersion Include="Corvus.Json.Validator" Version="5.8.8" />
    <!--
      The standard readers, measured against the corpus (ReaderLibraryTests, Q30 to Q32): test-only for now, since none
      targets netstandard2.0 for the generator. The AsyncAPI SDK (Apache-2.0; its tree MIT and Apache-2.0) and BinkyLabs
      Arazzo (MIT), pinned exactly. BinkyLabs Overlays is left out: it depends on JsonPath.Net 3 and JsonPointer.Net 7,
      which carry the Open Source Maintenance Fee EULA.
    -->
    <PackageVersion Include="Neuroglia.AsyncApi.IO" Version="3.0.6" />
    <PackageVersion Include="BinkyLabs.OpenApi.Arazzo" Version="1.0.0-preview.4" />
  </ItemGroup>
</Project>
