<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- What the generator package declares: the build metadata the generator reads, made visible to it. -->
  <Import Project="../Matchmark.Generator/build/Matchmark.Generator.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PetStore</RootNamespace>
    <!-- Show what the generator wrote under obj/generated. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The service implements the contract: it generates only the endpoints and the OpenAPI configuration. -->
    <AdditionalFiles Include="../Matchmark.Sample.Contract/petstore.yaml" Matchmark="true" MatchmarkNamespace="PetStore.Api" MatchmarkApiName="PetStore" MatchmarkParts="Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Matchmark.Sample.Contract/Matchmark.Sample.Contract.csproj" />
    <ProjectReference Include="../Matchmark.Generator/Matchmark.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>
</Project>
