<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Matchmark.Generator/Matchmark.Generator.csproj" />
    <ProjectReference Include="../Matchmark.Cli/Matchmark.Cli.csproj" />
    <!-- GeneratedRulesTests compile generated servers that enforce invariants with it. -->
    <ProjectReference Include="../Matchmark.Rules/Matchmark.Rules.csproj" />
    <ProjectReference Include="../Matchmark.Validation/Matchmark.Validation.csproj" />
    <ProjectReference Include="../Matchmark.Testing.NUnit/Matchmark.Testing.NUnit.csproj" />
    <!-- ConformanceTests run the middleware in front of a small hand-written API. -->
    <ProjectReference Include="../Matchmark.Conformance/Matchmark.Conformance.csproj" />
    <!-- MessagingTests: the generated AsyncAPI producer and consumer, in memory and on NATS. -->
    <ProjectReference Include="../Matchmark.Messaging.Nats/Matchmark.Messaging.Nats.csproj" />
    <!-- CorpusTests compile the generated contracts, which use Resultful's result types. -->
    <PackageReference Include="Resultful" />
  </ItemGroup>

  <ItemGroup>
    <!-- RegressCommandTests host a small hand-written API to run the regress command against. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generator's own dependencies are private to it; the tests load it in-process, so they need them too. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>
</Project>
