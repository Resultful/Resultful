<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Prototype: no analyzer release tracking for the MM diagnostics. -->
    <NoWarn>$(NoWarn);RS2008;NU5128</NoWarn>

    <!--
      Packed as an analyzer: the generator and the spec reader it loads beside it go in analyzers/dotnet/cs, and
      build/Matchmark.Generator.props declares the item metadata it reads, so a project only marks its spec.
    -->
    <IsPackable>true</IsPackable>
    <PackageId>Matchmark.Generator</PackageId>
    <Description>Generates an ASP.NET Core contract, server, client, fake and regression suite from an OpenAPI document.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(PKGMicrosoft_OpenApi)/lib/netstandard2.0/Microsoft.OpenApi.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(PKGMicrosoft_OpenApi_YamlReader)/lib/netstandard2.0/Microsoft.OpenApi.YamlReader.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(PKGSharpYaml)/lib/netstandard2.0/SharpYaml.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="build/Matchmark.Generator.props" Pack="true" PackagePath="build;buildTransitive" />
    <None Include="../Matchmark.Specs/bin/$(Configuration)/netstandard2.0/Matchmark.Specs.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../Matchmark.Specs.Overlay/bin/$(Configuration)/netstandard2.0/Matchmark.Specs.Overlay.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../Matchmark.Specs.Arazzo/bin/$(Configuration)/netstandard2.0/Matchmark.Specs.Arazzo.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- The benchmarks time the parse step, which is internal. -->
    <InternalsVisibleTo Include="Matchmark.Benchmarks" />
  </ItemGroup>
  <ItemGroup>
    <!-- Matchmark's own readers (Q56): referenced, and shipped beside the generator in the analyzer folder. -->
    <ProjectReference Include="../Matchmark.Specs/Matchmark.Specs.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Matchmark.Specs.Overlay/Matchmark.Specs.Overlay.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Matchmark.Specs.Arazzo/Matchmark.Specs.Arazzo.csproj" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.OpenApi" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="SharpYaml" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <!--
    The compiler loads an analyzer's dependencies from the analyzer's own folder, so the spec reader ships next to the
    generator. System.Text.Json is not shipped: the .NET 10 compiler host already provides a newer one.
  -->
  <Target Name="IncludeGeneratorDependencies" AfterTargets="ResolvePackageDependenciesForBuild">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="$(PKGMicrosoft_OpenApi)/lib/netstandard2.0/Microsoft.OpenApi.dll" IncludeRuntimeDependency="false" />
      <TargetPathWithTargetPlatformMoniker Include="$(PKGMicrosoft_OpenApi_YamlReader)/lib/netstandard2.0/Microsoft.OpenApi.YamlReader.dll" IncludeRuntimeDependency="false" />
      <TargetPathWithTargetPlatformMoniker Include="$(PKGSharpYaml)/lib/netstandard2.0/SharpYaml.dll" IncludeRuntimeDependency="false" />
      <TargetPathWithTargetPlatformMoniker Include="$(MSBuildThisFileDirectory)../Matchmark.Specs/bin/$(Configuration)/netstandard2.0/Matchmark.Specs.dll" IncludeRuntimeDependency="false" />
      <TargetPathWithTargetPlatformMoniker Include="$(MSBuildThisFileDirectory)../Matchmark.Specs.Overlay/bin/$(Configuration)/netstandard2.0/Matchmark.Specs.Overlay.dll" IncludeRuntimeDependency="false" />
      <TargetPathWithTargetPlatformMoniker Include="$(MSBuildThisFileDirectory)../Matchmark.Specs.Arazzo/bin/$(Configuration)/netstandard2.0/Matchmark.Specs.Arazzo.dll" IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>
</Project>
