<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Writes the server side of a spec as ordinary ASP.NET source a team owns: controllers (or Minimal API endpoints), a
    reference implementation of each handler interface, the conventions the spec implies, and Program.cs.
    Run it with dotnet run on this project, passing the spec and an output directory; see Program.cs for the options.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>matchmark</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>matchmark</ToolCommandName>
    <PackageId>Matchmark.Cli</PackageId>
    <Description>matchmark: scaffold, regress and audit from an OpenAPI document.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Matchmark.Generator/Matchmark.Generator.csproj" />
    <ProjectReference Include="../Matchmark.Testing/Matchmark.Testing.csproj" />
    <!-- twin serves a stateful fake with ASP.NET Core. -->
    <ProjectReference Include="../Matchmark.Conformance/Matchmark.Conformance.csproj" />
    <!-- The generator's own dependencies are private to it; as a library here, they're needed at run time. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" />
  </ItemGroup>
</Project>
