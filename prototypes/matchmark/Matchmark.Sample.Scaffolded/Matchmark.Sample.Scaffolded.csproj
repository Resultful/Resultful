<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- What the generator package declares: the build metadata the generator reads, made visible to it. -->
  <Import Project="../Matchmark.Generator/build/Matchmark.Generator.props" />
  <!--
    The Pet Store service as Matchmark.Cli writes it, untouched: controllers, a reference implementation that
    answers with the spec's examples, conventions and Program.cs. Only this project file was written by hand. The contract
    comes from the Contract project; nothing on the server side is generated at build time.
    The command that wrote it is in PETSTORE.md, and ScaffoldTests checks that it still writes exactly these files.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PetStore.Scaffolded</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Verify: the build checks these hand-written controllers against the spec. Every operation must have an action with
      its operationId, route and documented responses, and every other action must be left out of the OpenAPI description.
      Nothing is generated here.
    -->
    <AdditionalFiles Include="../Matchmark.Sample.Contract/petstore.yaml" Matchmark="true" MatchmarkNamespace="PetStore.Api" MatchmarkApiName="PetStore" MatchmarkOutcomes="Resultful" MatchmarkParts="Verify" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Matchmark.Generator/Matchmark.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Matchmark.Sample.Contract/Matchmark.Sample.Contract.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
</Project>
