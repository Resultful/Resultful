<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="OneOf" Version="3.0.271" />

    <!-- Generators and analyzers: built against 4.14.0 with VersionOverride (SDK 9.0.3xx, loads in every later compiler). The tests
         compile in process with 5.12.0, SDK 11.0.100's compiler, so they parse C# 15 unions. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="NUnit" Version="4.3.2" />
    <PackageVersion Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageVersion Include="NunitXml.TestLogger" Version="5.0.0" />
    <PackageVersion Include="FluentAssertions" Version="7.2.0" />
    <PackageVersion Include="FluentAssertions.OneOf" Version="0.0.5" />
    <PackageVersion Include="CsCheck" Version="5.0.1" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <!-- ASP.NET Core packages follow the target framework: 10.x on net10.0, 11.x on net11.0. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
  </ItemGroup>
  <!-- Resultful.FluentValidation and Resultful.Diagnostics (stack B 21): a satellite depends on the lowest version it needs,
       on every target, and the tests run on that floor. -->
  <ItemGroup>
    <PackageVersion Include="FluentValidation" Version="12.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>
</Project>
