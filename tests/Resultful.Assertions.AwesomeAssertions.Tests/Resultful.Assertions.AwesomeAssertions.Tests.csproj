<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for Resultful.Assertions.AwesomeAssertions on the latest AwesomeAssertions. The same sources run against
       FluentAssertions 7 in Resultful.Assertions.FluentAssertions.Tests. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Resultful.Assertions.AdapterTests</RootNamespace>
    <!-- The test types are public for xunit and CsCheck. -->
    <NoWarn>$(NoWarn);CA1515;CA1034;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Resultful.Assertions.AwesomeAssertions\Resultful.Assertions.AwesomeAssertions.csproj" />
    <ProjectReference Include="..\Resultful.Assertions.TestDomain\Resultful.Assertions.TestDomain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="CsCheck" />
  </ItemGroup>
</Project>
