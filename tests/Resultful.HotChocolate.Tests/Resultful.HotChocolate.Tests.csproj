<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for Resultful.HotChocolate: xunit.v3 scenarios through HotChocolate's real IRequestExecutor, schema SDL pinned
       as raw strings, and CsCheck laws, run by `dotnet test` (VSTest). -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Resultful.HotChocolate.Tests</RootNamespace>
    <!-- The test types are public for xunit, CsCheck and HotChocolate's type inference. -->
    <NoWarn>$(NoWarn);CA1515;CA1034;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Resultful.HotChocolate\Resultful.HotChocolate.csproj" />
    <!-- The real generator writes the closed hierarchies' and unions' Cases and the shapes, as it does for an app. -->
    <ProjectReference Include="..\..\src\Resultful.Generators.Roslyn5\Resultful.Generators.Roslyn5.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="CsCheck" />
    <!-- Paging and projection, to check that a result field refuses them. -->
    <PackageReference Include="HotChocolate.Data" />
    <PackageReference Include="HotChocolate.Types.CursorPagination" />
  </ItemGroup>
</Project>
