<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for Resultful.Assertions.FluentAssertions on FluentAssertions 7.2.0: the AwesomeAssertions adapter's test
       sources, compiled with RESULTFUL_FLUENTASSERTIONS, so both adapters pass the same tests and messages. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Resultful.Assertions.AdapterTests</RootNamespace>
    <DefineConstants>$(DefineConstants);RESULTFUL_FLUENTASSERTIONS</DefineConstants>
    <!-- The test types are public for xunit and CsCheck. -->
    <NoWarn>$(NoWarn);CA1515;CA1034;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Resultful.Assertions.AwesomeAssertions.Tests\*.cs" Exclude="..\Resultful.Assertions.AwesomeAssertions.Tests\obj\**;..\Resultful.Assertions.AwesomeAssertions.Tests\bin\**" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Resultful.Assertions.FluentAssertions\Resultful.Assertions.FluentAssertions.csproj" />
    <ProjectReference Include="..\Resultful.Assertions.TestDomain\Resultful.Assertions.TestDomain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="CsCheck" />
  </ItemGroup>
</Project>
