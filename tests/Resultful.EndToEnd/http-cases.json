{
  "comment": "One request per error leaf the Shop's API exposes, plus each success. The HTTP map is DECISIONS-TAKEN.md (04c): ValidationFailed is 400 with ValidationProblemDetails, a mapped leaf its status (404, 409), anything else 500 with a fixed title and no Message outside Development. A 4xx ProblemDetails carries the error's Message as detail. `body` is a subset match; `absent` lists keys that must not appear; `mustNotContain` lists text that must not appear anywhere in the body. Each case runs against Shop.Api built for its use case alone (ShopForce=<useCase>), in the Production environment, on every target. Every case is on ledger line HTTP-CASES (20b); the OpenAPI check of each is on HTTP-OPENAPI.",
  "environment": "Production",
  "cases": [
    { "useCase": "UC01", "leaf": null, "method": "GET", "path": "/api/orders/1", "route": "/api/orders/{id}", "status": 200,
      "body": { "id": 1, "name": "teapot" } },
    { "useCase": "UC01", "leaf": "OrderNotFound", "method": "GET", "path": "/api/orders/999", "route": "/api/orders/{id}", "status": 404,
      "problem": true, "body": { "status": 404, "title": "Not Found", "detail": "order 999 was not found" } },
    { "useCase": "UC01", "leaf": "OrderLocked", "method": "GET", "path": "/api/orders/2", "route": "/api/orders/{id}", "status": 409,
      "problem": true, "body": { "status": 409, "title": "Conflict", "detail": "order 2 is locked by alice" } },

    { "useCase": "UC02", "leaf": null, "method": "POST", "path": "/api/sign-up/check", "route": "/api/sign-up/check", "status": 200,
      "request": { "name": "Ada", "email": "ada@example.com", "password": "correct horse battery" } },
    { "useCase": "UC02", "leaf": "Required, NotAnEmail", "method": "POST", "path": "/api/sign-up/check", "route": "/api/sign-up/check", "status": 400,
      "request": { "name": "", "email": "not-an-email", "password": "correct horse battery" },
      "problem": true, "body": { "status": 400, "title": "One or more validation errors occurred.",
        "errors": { "name": [ "name is required" ], "email": [ "email is not an email address" ] } },
      "absent": [ "errors.password" ] },
    { "useCase": "UC02", "leaf": "TooShort", "method": "POST", "path": "/api/sign-up/check", "route": "/api/sign-up/check", "status": 400,
      "request": { "name": "Ada", "email": "ada@example.com", "password": "short" },
      "problem": true, "body": { "status": 400, "errors": { "password": [ "password needs at least 12 characters" ] } },
      "absent": [ "errors.name", "errors.email" ] },

    { "useCase": "UC03", "leaf": null, "method": "POST", "path": "/api/sign-up", "route": "/api/sign-up", "status": 200,
      "request": { "name": "Ada", "email": "ada@example.com", "password": "correct horse battery" },
      "body": { "id": 2, "name": "Ada" } },
    { "useCase": "UC03", "leaf": "EmailTaken", "method": "POST", "path": "/api/sign-up", "route": "/api/sign-up", "status": 409,
      "request": { "name": "Ada", "email": "taken@example.com", "password": "correct horse battery" },
      "problem": true, "body": { "status": 409, "title": "Conflict", "detail": "taken@example.com is already registered" } },
    { "useCase": "UC03", "leaf": "ValidationFailed<InputError>", "method": "POST", "path": "/api/sign-up", "route": "/api/sign-up", "status": 400,
      "request": { "name": "Ada", "email": "ada@example.com", "password": null },
      "problem": true, "body": { "status": 400, "errors": { "password": [ "password is required" ] } } },

    { "useCase": "UC04", "leaf": null, "method": "GET", "path": "/api/invoices/1", "route": "/api/invoices/{id}", "status": 200,
      "body": { "id": 1 } },
    { "useCase": "UC04", "leaf": "DbTimeout", "method": "GET", "path": "/api/invoices/42", "route": "/api/invoices/{id}", "status": 500,
      "problem": true, "body": { "status": 500, "title": "An error occurred while processing your request." },
      "absent": [ "detail" ], "mustNotContain": [ "timed out", "loading order 42" ] },
    { "useCase": "UC04", "leaf": "DbTimeout (context keeps the type)", "method": "POST", "path": "/invoices/42/run", "route": "/invoices/{id}/run", "status": 200,
      "body": { "delay": "00:01:00" } },

    { "useCase": "UC05", "leaf": null, "method": "POST", "path": "/api/payments", "route": "/api/payments", "status": 200,
      "request": { "orderId": 1, "total": 10, "card": "4242" }, "body": { "value": "pay_10_4242" } },
    { "useCase": "UC05", "leaf": "CardDeclined", "method": "POST", "path": "/api/payments", "route": "/api/payments", "status": 409,
      "request": { "orderId": 1, "total": 10, "card": "0000" },
      "problem": true, "body": { "status": 409, "detail": "The card was declined." },
      "mustNotContain": [ "insufficient funds" ] },
    { "useCase": "UC05", "leaf": "FraudSuspected", "method": "POST", "path": "/api/payments", "route": "/api/payments", "status": 500,
      "request": { "orderId": 1, "total": 10, "card": "6666" },
      "problem": true, "body": { "status": 500, "title": "An error occurred while processing your request." },
      "absent": [ "detail" ], "mustNotContain": [ "payment blocked", "risk score" ] },
    { "useCase": "UC05", "leaf": "ProviderUnavailable", "method": "POST", "path": "/api/payments", "route": "/api/payments", "status": 500,
      "request": { "orderId": 1, "total": 10, "card": "5000" },
      "problem": true, "body": { "status": 500, "title": "An error occurred while processing your request." },
      "absent": [ "detail" ], "mustNotContain": [ "unavailable", "upstream" ] },

    { "useCase": "UC07", "leaf": "OrderLocked (logged, not thrown away)", "method": "POST", "path": "/baskets/cancel-abandoned", "route": "/baskets/cancel-abandoned", "status": 200 }
  ]
}
