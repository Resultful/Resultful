<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for Resultful.Diagnostics: xunit.v3 scenarios and CsCheck laws, with a capturing ILogger and an ActivityListener,
       run by `dotnet test` (VSTest). -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Resultful.Diagnostics.Tests</RootNamespace>
    <!-- The test types are public for xunit and CsCheck. -->
    <NoWarn>$(NoWarn);CA1515;CA1034;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Resultful.Diagnostics\Resultful.Diagnostics.csproj" />
    <ProjectReference Include="..\..\src\Resultful.FluentValidation\Resultful.FluentValidation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="CsCheck" />
  </ItemGroup>
</Project>
