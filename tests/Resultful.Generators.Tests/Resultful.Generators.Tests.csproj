    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1859;CA1034</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Resultful.Generators\Resultful.Generators.csproj" />
  </ItemGroup>

  <ItemGroup>
