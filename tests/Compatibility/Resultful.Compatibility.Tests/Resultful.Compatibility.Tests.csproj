<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Packed-package consumer checks: packs Resultful and Resultful.Generators, then builds and runs ../Generators (a
    hierarchy in one assembly, shapes in another) with each compiler leg's SDK, outside the repository. In
    Resultful.slnx for build and format, but not a test project there: CI's generator-legs job runs it with every
    leg's SDK installed (dotnet run -c Release).
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>false</IsTestProject>
    <NoWarn>$(NoWarn);CA1515;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RepoRootDir" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../..'))" />
  </ItemGroup>
</Project>
