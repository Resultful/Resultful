<Project Sdk="Microsoft.NET.Sdk">
  <!-- A hierarchy in its own assembly, built against the packed packages by Resultful.Compatibility.Tests. -->
  <PropertyGroup>
    <TargetFramework>$(CompatTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Resultful" Version="[$(ResultfulVersion)]" />
    <PackageReference Include="Resultful.Generators" Version="[$(ResultfulVersion)]" PrivateAssets="all" />
  </ItemGroup>
  <!-- The analyzers the compiler was given, so the test can tell which build of the generator loaded. -->
  <Target Name="CompatReportAnalyzers" AfterTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)analyzers.txt" Lines="@(Analyzer->'%(FullPath)')" Overwrite="true" />
  </Target>
</Project>
