<Project>
  <!--
    Consumers of the packed package, run only by eng/build.cs's Compat* targets (not part of Resultful.slnx).
    They stand alone, like a consumer's own repository: nothing is imported
    from the folders above, there is no central package management, and Resultful comes from the packed nupkg alone
    (the Compat* targets restore them with source mapping into an empty packages folder).
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>

    <!-- NuGetAudit on the whole graph: a vulnerable package anywhere (direct or transitive) fails the restore. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <!--
      Package pruning off, so packages the framework already provides are still resolved and audited, as for a
      consumer on an older SDK. With it on, 0.2.0-beta05's NETStandard.Library 1.6.1 chain (System.Net.Http 4.3.0,
      NU1903) is pruned away and the audit can't see it; with it off, beta05 fails this restore.
    -->
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
  </PropertyGroup>

  <!-- The version under test: the Compat* targets pass the packed one, e.g. -p:ResultfulPackageVersion=0.2.0. -->
  <Target Name="_RequireResultfulPackageVersion" BeforeTargets="CollectPackageReferences;Restore;Build" Condition="'$(ResultfulPackageVersion)' == ''">
    <Error Text="Pass -p:ResultfulPackageVersion=&lt;version&gt; of a freshly packed Resultful (eng/build.cs's Compat* targets do)." />
  </Target>

  <ItemGroup>
    <!-- An exact version, so a newer published Resultful can't stand in for the packed one. -->
    <PackageReference Include="Resultful" Version="[$(ResultfulPackageVersion)]" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ResultfulPackageVersion" Value="$(ResultfulPackageVersion)" />
  </ItemGroup>
</Project>
