<Project>
  <!-- The 0.3 target API: every package's end-state public surface as `throw null` stubs. Never packed or shipped. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Stubs have no bodies, so the code-quality analyzers have nothing to say. The PublicAPI analyzer still runs. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Stub-only noise: CS0067 unused events, CS8597 `throw null`, CS0618/CS0612 the target's own obsolete members. -->
    <NoWarn>$(NoWarn);CS0067;CS8597;CS0618;CS0612</NoWarn>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <!-- Only the stub projects (each has a PublicAPI folder); check-api.cs, a file-based app here, has none. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/PublicAPI')">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
