<Project>
  <!-- Settings for every project under this folder. Nothing here is packed. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1305;CA1822;CA1062;CA1707</NoWarn>
  </PropertyGroup>
</Project>
