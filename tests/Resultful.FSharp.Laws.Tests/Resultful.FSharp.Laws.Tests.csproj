<Project Sdk="Microsoft.NET.Sdk">
  <!-- Resultful.FSharp's conversion laws and scenarios from C#: xunit.v3 and CsCheck, run by `dotnet test` (VSTest).
       The F# side is tests/Resultful.FSharp.Tests. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Resultful.FSharp.Laws.Tests</RootNamespace>
    <!-- The test types are public for xunit and CsCheck. -->
    <NoWarn>$(NoWarn);CA1515;CA1034;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Resultful.FSharp\Resultful.FSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="CsCheck" />
  </ItemGroup>
</Project>
