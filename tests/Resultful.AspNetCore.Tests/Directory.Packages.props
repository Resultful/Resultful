<Project>
  <!-- Adds only what the root file lacks. Moved up into the root Directory.Packages.props at wiring. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)../'))" />
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
  <!-- ASP.NET Core packages follow the target framework (GOAL.md, Known traps): 10.x on net10.0, 11.x on net11.0. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
  </ItemGroup>
</Project>
